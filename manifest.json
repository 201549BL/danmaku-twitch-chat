{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.7.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "fontSettings",
    "storage"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/text-effects/ember.webp"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/i18n.js",
        "src/shared/settings.js",
        "src/shared/engagement.js",
        "src/shared/release-notes.js",
        "src/shared/translation-feedback.js",
        "src/content/twitch-detector.js",
        "src/content/chat-observer.js",
        "src/content/username-effects.js",
        "src/content/renderer.js",
        "src/content/overlay.js",
        "src/content/region-editor.js",
        "src/content/mock-chat.js",
        "src/content/settings-panel.js",
        "src/content/player-toggle.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/overlay.css",
        "src/content/settings-panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "__MSG_extensionShortName__"
  }
}
